---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const clean = penguins.filter(
  (d) => d.culmen_length_mm != null && d.culmen_depth_mm != null,
);
---

<Layout>
  <h1 class="text-3xl font-bold p-4">Manchots de Palmer</h1>

  <figure class="p-4">
    <PlotFigure
      options={{
        title: "Longueur vs profondeur du bec",
        subtitle: "Trois espèces de l’archipel Palmer",
        caption:
          "Figure 1. Points colorés par espèce. Les valeurs manquantes sont exclues.",
        ariaLabel:
          "Nuage de points longueur du bec en abscisse, profondeur en ordonnée, couleur = espèce",
        color: { legend: true },
        grid: true,
        marks: [
          Plot.dot(clean, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
    <figcaption class="text-sm text-gray-600 mt-2">
      Figure 1. Longueur et profondeur du bec par espèce.
    </figcaption>
  </figure>

  <figure class="p-4">
    <PlotFigure
      options={{
        title: "Effectifs par espèce",
        caption: "Figure 2. Nombre d’individus observés.",
        ariaLabel: "Diagramme en barres du nombre de manchots par espèce",
        marks: [
          Plot.barY(
            penguins,
            Plot.groupX({ y: "count" }, { x: "species", fill: "species" }),
          ),
          Plot.ruleY([0]),
        ],
      }}
    />
    <figcaption>Figure 2. Répartition par espèce.</figcaption>
  </figure>
</Layout>
