---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

// Filtrer les valeurs nulles pour les axes numériques
const data = penguins.filter(
  (d) => d.culmen_length_mm != null && d.culmen_depth_mm != null,
);
---

<Layout title="Palmer Penguins — Exploration">
  <main class="min-h-screen bg-slate-950 text-slate-100">
    <header
      class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-10"
    >
      <div
        class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4"
      >
        <div class="flex items-center gap-3">
          <span class="text-3xl" aria-hidden="true">🐧</span>
          <div>
            <h1 class="text-xl font-semibold tracking-tight">
              Palmer Penguins
            </h1>
            <p class="text-sm text-slate-400">
              Archipel Palmer · Antarctique · 2007-2009
            </p>
          </div>
        </div>
        <nav class="flex gap-2 text-sm" aria-label="Navigation principale">
          <a
            href="/"
            class="px-3 py-1.5 rounded-full bg-cyan-500/20 text-cyan-300 font-medium"
            aria-current="page">Accueil</a
          >
          <a
            href="/leaflet"
            class="px-3 py-1.5 rounded-full hover:bg-slate-800 text-slate-300 transition"
            >Carte Leaflet</a
          >
          <a
            href="/geojson"
            class="px-3 py-1.5 rounded-full hover:bg-slate-800 text-slate-300 transition"
            >GeoJSON / Plot</a
          >
        </nav>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 py-8 space-y-10">
      <!-- Intro a11y -->
      <section aria-labelledby="intro-heading">
        <h2 id="intro-heading" class="sr-only">Introduction</h2>
        <p class="text-slate-300 max-w-3xl">
          Jeu de données de 344 manchots (Adélie, Chinstrap, Gentoo) mesurés sur
          trois îles. Visualisation interactive avec Observable Plot, en
          respectant les bonnes pratiques d’accessibilité (titre, sous-titre,
          légende, <code class="text-cyan-400">aria-label</code>).
        </p>
      </section>

      <!-- Graphique principal avec a11y Plot -->
      <figure
        class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xl"
      >
        <PlotFigure
          options={{
            title: "Longueur vs profondeur du bec (culmen)",
            subtitle:
              "Chaque point représente un manchot. La couleur indique l’espèce.",
            caption:
              "Figure 1. Relation entre la longueur et la profondeur du bec selon l’espèce. Les Gentoo ont en moyenne un bec plus long et moins profond.",
            ariaLabel:
              "Nuage de points : longueur du bec en abscisse, profondeur en ordonnée, coloré par espèce (Adélie, Chinstrap, Gentoo)",
            grid: true,
            color: {
              legend: true,
              label: "Espèce",
            },
            x: { label: "Longueur du bec (mm) →" },
            y: { label: "↑ Profondeur du bec (mm)" },
            marks: [
              Plot.frame({ stroke: "#334155" }),
              Plot.dot(data, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
                tip: true,
              }),
            ],
            width: 720,
            height: 480,
            style: {
              background: "transparent",
              color: "#e2e8f0",
              fontFamily: "system-ui, sans-serif",
            },
          }}
        />
      </figure>

      <!-- Stats rapides -->
      <section
        aria-labelledby="stats-heading"
        class="grid grid-cols-2 sm:grid-cols-4 gap-4"
      >
        <h2 id="stats-heading" class="sr-only">Statistiques</h2>
        <div
          class="bg-slate-900 border border-slate-800 rounded-xl p-4 text-center"
        >
          <p class="text-3xl font-bold text-cyan-400">{penguins.length}</p>
          <p class="text-sm text-slate-400">Manchots</p>
        </div>
        <div
          class="bg-slate-900 border border-slate-800 rounded-xl p-4 text-center"
        >
          <p class="text-3xl font-bold text-rose-400">3</p>
          <p class="text-sm text-slate-400">Espèces</p>
        </div>
        <div
          class="bg-slate-900 border border-slate-800 rounded-xl p-4 text-center"
        >
          <p class="text-3xl font-bold text-emerald-400">3</p>
          <p class="text-sm text-slate-400">Îles</p>
        </div>
        <div
          class="bg-slate-900 border border-slate-800 rounded-xl p-4 text-center"
        >
          <p class="text-3xl font-bold text-amber-400">2007-09</p>
          <p class="text-sm text-slate-400">Années</p>
        </div>
      </section>

      <!-- Note a11y -->
      <aside
        class="text-sm text-slate-400 border-l-4 border-cyan-500/50 pl-4"
        role="note"
      >
        <p>
          <strong class="text-slate-200">Accessibilité (a11y) :</strong>
          Le graphique utilise les options natives de Plot (<code>title</code>, <code
            >subtitle</code
          >, <code>caption</code>, <code>ariaLabel</code>). Vérifiez avec
          Lighthouse et l’arborescence d’accessibilité des DevTools Chrome.
        </p>
      </aside>
    </div>

    <footer
      class="border-t border-slate-800 mt-12 py-6 text-center text-sm text-slate-500"
    >
      <p>
        Données <a
          href="https://allisonhorst.github.io/palmerpenguins/"
          class="text-cyan-400 hover:underline"
          target="_blank"
          rel="noopener">palmerpenguins</a
        >
        · Base <a
          href="https://github.com/ppierre/base-astro-tw-plot"
          class="text-cyan-400 hover:underline"
          target="_blank"
          rel="noopener">base-astro-tw-plot</a
        >
        · Astro + Tailwind + Observable Plot · Netlify
      </p>
    </footer>
  </main>
</Layout>
