---
import Layout from "../layouts/Layout.astro";
import penguins from "../assets/penguins.json";
---

<Layout>
    <h1 class="text-2xl p-4">Données brutes</h1>
    <div class="overflow-x-auto p-4">
        <table class="min-w-full text-sm border-collapse">
            <caption class="text-left font-medium mb-2"
                >Mesures des manchots (extrait du jeu Palmer)</caption
            >
            <thead>
                <tr class="bg-gray-100">
                    <th scope="col" class="border p-2">Espèce</th>
                    <th scope="col" class="border p-2">Île</th>
                    <th scope="col" class="border p-2">Bec L (mm)</th>
                    <th scope="col" class="border p-2">Bec P (mm)</th>
                    <th scope="col" class="border p-2">Nageoire (mm)</th>
                    <th scope="col" class="border p-2">Masse (g)</th>
                    <th scope="col" class="border p-2">Sexe</th>
                </tr>
            </thead>
            <tbody>
                {
                    penguins.slice(0, 50).map((d) => (
                        <tr>
                            <td class="border p-2">{d.species}</td>
                            <td class="border p-2">{d.island}</td>
                            <td class="border p-2">
                                {d.culmen_length_mm ?? "—"}
                            </td>
                            <td class="border p-2">
                                {d.culmen_depth_mm ?? "—"}
                            </td>
                            <td class="border p-2">
                                {d.flipper_length_mm ?? "—"}
                            </td>
                            <td class="border p-2">{d.body_mass_g ?? "—"}</td>
                            <td class="border p-2">{d.sex ?? "—"}</td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</Layout>
