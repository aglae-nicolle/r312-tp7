---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carte Leaflet — Îles Palmer">
    <main class="min-h-screen bg-slate-950 text-slate-100">
        <header
            class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-10"
        >
            <div
                class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4"
            >
                <div class="flex items-center gap-3">
                    <span class="text-3xl" aria-hidden="true">🗺️</span>
                    <div>
                        <h1 class="text-xl font-semibold tracking-tight">
                            Carte Leaflet
                        </h1>
                        <p class="text-sm text-slate-400">
                            Îles de l’Archipel Palmer (Antarctique)
                        </p>
                    </div>
                </div>
                <nav
                    class="flex gap-2 text-sm"
                    aria-label="Navigation principale"
                >
                    <a
                        href="/"
                        class="px-3 py-1.5 rounded-full hover:bg-slate-800 text-slate-300 transition"
                        >Accueil</a
                    >
                    <a
                        href="/leaflet"
                        class="px-3 py-1.5 rounded-full bg-cyan-500/20 text-cyan-300 font-medium"
                        aria-current="page">Carte Leaflet</a
                    >
                    <a
                        href="/geojson"
                        class="px-3 py-1.5 rounded-full hover:bg-slate-800 text-slate-300 transition"
                        >GeoJSON / Plot</a
                    >
                </nav>
            </div>
        </header>

        <div class="max-w-6xl mx-auto px-4 py-8 space-y-6">
            <p class="text-slate-300 max-w-3xl">
                Carte interactive des trois îles où ont été observés les
                manchots Palmer :
                <strong>Torgersen</strong>, <strong>Biscoe</strong> et <strong
                    >Dream</strong
                >. Réalisée avec Leaflet (chargement côté client).
            </p>

            <div
                id="map"
                class="h-[600px] w-full rounded-2xl border border-slate-800 shadow-xl overflow-hidden"
                role="application"
                aria-label="Carte interactive de l’Archipel Palmer montrant les îles Torgersen, Biscoe et Dream"
            >
            </div>

            <aside
                class="text-sm text-slate-400 border-l-4 border-cyan-500/50 pl-4"
                role="note"
            >
                <p>
                    <strong class="text-slate-200">Accessibilité :</strong>
                    La div de la carte possède un <code>aria-label</code> descriptif.
                    Les marqueurs Leaflet exposent un titre au focus clavier.
                </p>
            </aside>
        </div>
    </main>
</Layout>

<!-- Leaflet CSS + JS via CDN (statique, compatible Netlify) -->
<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
/>
<script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""></script>

<script>
    // Attendre que le DOM et Leaflet soient prêts
    document.addEventListener("DOMContentLoaded", () => {
        // @ts-ignore
        const L = window.L;
        if (!L) {
            console.error("Leaflet non chargé");
            return;
        }

        // Centre approximatif de l’Archipel Palmer
        const map = L.map("map").setView([-64.77, -64.05], 9);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 18,
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        }).addTo(map);

        // Coordonnées approximatives des îles (sources publiques)
        const islands = [
            {
                name: "Île Torgersen",
                coords: [-64.773, -64.073],
                species: "Principalement Adélie",
                color: "#ff6b6b",
            },
            {
                name: "Île Biscoe",
                coords: [-64.82, -63.77],
                species: "Adélie & Gentoo",
                color: "#4ecdc4",
            },
            {
                name: "Île Dream",
                coords: [-64.733, -64.233],
                species: "Adélie & Chinstrap",
                color: "#ffe66d",
            },
        ];

        islands.forEach((island) => {
            const marker = L.circleMarker(island.coords, {
                radius: 12,
                fillColor: island.color,
                color: "#0f172a",
                weight: 2,
                opacity: 1,
                fillOpacity: 0.9,
            }).addTo(map);

            marker.bindPopup(
                `<strong>${island.name}</strong><br/>Espèces : ${island.species}`,
            );
            marker.bindTooltip(island.name, {
                permanent: false,
                direction: "top",
            });
        });

        // Légende simple
        const legend = L.control({ position: "bottomright" });
        legend.onAdd = function () {
            const div = L.DomUtil.create("div", "info legend");
            div.style.cssText =
                "background:rgba(15,23,42,0.9);color:#e2e8f0;padding:10px 14px;border-radius:8px;font-size:13px;border:1px solid #334155;";
            div.innerHTML = `
        <strong style="display:block;margin-bottom:6px">Îles</strong>
        <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#ff6b6b;margin-right:6px"></span> Torgersen<br/>
        <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#4ecdc4;margin-right:6px"></span> Biscoe<br/>
        <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#ffe66d;margin-right:6px"></span> Dream
      `;
            return div;
        };
        legend.addTo(map);
    });
</script>
